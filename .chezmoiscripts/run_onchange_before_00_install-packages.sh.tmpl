#!/bin/bash
set -euo pipefail

# Hash: {{ includeTemplate ".chezmoidata.yaml" | sha256sum }}

# ==========================================
# OS detection & Normalization (chezmoi level)
# ==========================================
{{ $osid := .chezmoi.osRelease.id }}
{{ $idLike := default "" (get .chezmoi.osRelease "idLike") }}

# Determine the OS family (for package manager selection & base packages)
{{ $osFamily := $osid }}
{{ if contains "arch" $idLike }}
    {{ $osFamily = "arch" }}
{{ else if contains "debian" $idLike }}
    {{ $osFamily = "debian" }}
{{ else if or (contains "fedora" $idLike) (contains "rhel" $idLike) (contains "centos" $idLike) }}
    {{ $osFamily = "fedora" }}
{{ end }}

# Create a list of distros to pull packages from (e.g., ["debian", "ubuntu"])
# This allows inheritance!
{{- $distroKeys := list $osFamily -}}

{{- if ne $osid $osFamily -}}
    {{- $standalone := false -}}

    # Check if the specific OS is defined in YAML and has the standalone flag
    {{- if hasKey $.packages.distros $osid -}}
        {{- $specificDistro := index $.packages.distros $osid -}}
        {{- if hasKey $specificDistro "standalone" -}}
            {{- $standalone = $specificDistro.standalone -}}
        {{- end -}}
    {{- end -}}

    # If standalone is true, overwrite the list so it ONLY contains the specific OS
    {{- if $standalone -}}
        {{- $distroKeys = list $osid -}}
    # Otherwise, inherit normally (e.g., ["arch", "cachyos"])
    {{- else -}}
        {{- $distroKeys = append $distroKeys $osid -}}
    {{- end -}}
{{- end }}


NC="\033[0m"
BLUE="\033[0;34m"
YELLOW="\033[33m"
GREEN="\033[0;32m"

# Hand over the chezmoi variable to bash
CURRENT_OS="{{ $osFamily }}"

echo -e "${BLUE}==> Assembling packages for OS: ${CURRENT_OS}...${NC}"

declare -A PKG_MANAGERS=(
    ["arch"]="sudo pacman -S --needed --noconfirm"
    ["fedora"]="sudo dnf install -y --skip-broken"
    ["ubuntu"]="sudo apt-get install -y"
    ["debian"]="sudo apt-get install -y"
)

INSTALL_CMD="${PKG_MANAGERS[$CURRENT_OS]:-}"
if [ -z "$INSTALL_CMD" ]; then
    echo -e "${YELLOW}Error: No package manager defined for OS '$CURRENT_OS'.${NC}"
    exit 1
fi

# ==========================================
# The Universal Replace/Exclude Engine
# ==========================================
{{- define "process_pkgs" -}}
    {{- $distroKeys := .distroKeys -}}
    {{- $distrosData := .distrosData -}}

    {{- range $pkg := .pkgs -}}
        {{- $final_pkg := $pkg -}}
        {{- $skip := false -}}

        {{- range $distroKey := $distroKeys -}}
            {{- if hasKey $distrosData $distroKey -}}
                {{- $d := index $distrosData $distroKey -}}

                {{- if hasKey $d "exclude" -}}
                    {{- if has $pkg $d.exclude }}{{ $skip = true }}{{ end -}}
                {{- end -}}

                {{- if hasKey $d "replace" -}}
                    {{- if hasKey $d.replace $pkg }}{{ $final_pkg = index $d.replace $pkg }}{{ end -}}
                {{- end -}}
            {{- end -}}
        {{- end -}}

        {{- if not $skip }}"{{ $final_pkg }}" {{ end -}}
    {{- end -}}
{{- end }}

# ==========================================
# Dynamically assemble the package arrays
# ==========================================
SYSTEM_PKGS=()
AUR_PKGS=()

# Global Common Packages
SYSTEM_PKGS+=( {{ template "process_pkgs" dict "pkgs" .packages.common "distroKeys" $distroKeys "distrosData" .packages.distros }} )

# Distro-specific additions (e.g. packages under distros.arch.packages)
{{ range $distroKey := $distroKeys }}
    {{ if hasKey $.packages.distros $distroKey }}
        {{ $distro := index $.packages.distros $distroKey }}

        {{ if hasKey $distro "packages" }}
            SYSTEM_PKGS+=( {{ range $distro.packages }}"{{ . }}" {{ end }} )
        {{ end }}

        {{ if eq $osFamily "arch" }}
            {{ if hasKey $distro "aur_packages" }}
                AUR_PKGS+=( {{ range $distro.aur_packages }}"{{ . }}" {{ end }} )
            {{ end }}
        {{ end }}
    {{ end }}
{{ end }}

# Global Desktop Packages
{{ if .config.setup_custom_desktop }}
    SYSTEM_PKGS+=( {{ template "process_pkgs" dict "pkgs" .packages.desktop_common "distroKeys" $distroKeys "distrosData" .packages.distros }} )

    # Protocols (Wayland / Xorg)
    {{ range .config.display_protocols }}
        {{ $global_proto_key := printf "desktop_%s" . }}
        {{ if hasKey $.packages $global_proto_key }}
            SYSTEM_PKGS+=( {{ template "process_pkgs" dict "pkgs" (index $.packages $global_proto_key) "distroKeys" $distroKeys "distrosData" $.packages.distros }} )
        {{ end }}

        # Distro-specific protocol additions (e.g. desktop_wayland, aur_wayland)
        {{ range $distroKey := $distroKeys }}
            {{ if hasKey $.packages.distros $distroKey }}
                {{ $distro := index $.packages.distros $distroKey }}

                # System protocol packages
                {{ if hasKey $distro $global_proto_key }}
                    SYSTEM_PKGS+=( {{ range index $distro $global_proto_key }}"{{ . }}" {{ end }} )
                {{ end }}

                # AUR protocol packages (arch only)
                {{ if eq $osFamily "arch" }}
                    {{ $aur_proto_key := printf "aur_%s" . }}
                    {{ if hasKey $distro $aur_proto_key }}
                        AUR_PKGS+=( {{ range index $distro $aur_proto_key }}"{{ . }}" {{ end }} )
                    {{ end }}
                {{ end }}
            {{ end }}
        {{ end }}
    {{ end }}

    # Window Managers
    {{ range $.config.wms }}
        {{ $wm := . }}
        {{ $pkgList := list }}
        {{ $foundDistroWm := false }}

        # Check if any active distro defines its own custom wm_packages
        {{ range $distroKey := $distroKeys }}
            {{ if hasKey $.packages.distros $distroKey }}
                {{ $d := index $.packages.distros $distroKey }}
                {{ if hasKey $d "wm_packages" }}
                    {{ $dWm := index $d "wm_packages" }}
                    {{ if hasKey $dWm $wm }}
                        {{ $pkgList = index $dWm $wm }}
                        {{ $foundDistroWm = true }}
                    {{ end }}
                {{ end }}
            {{ end }}
        {{ end }}

        # If a distro-specific override exists, use it directly
        {{ if $foundDistroWm }}
            SYSTEM_PKGS+=( {{ range $pkgList }}"{{ . }}" {{ end }} )
        # Otherwise, fallback to the global wm_packages and run through the Replace/Exclude engine
        {{ else }}
            {{ if hasKey $.packages "wm_packages" }}
                {{ if hasKey $.packages.wm_packages $wm }}
                    SYSTEM_PKGS+=( {{ template "process_pkgs" dict "pkgs" (index $.packages.wm_packages $wm) "distroKeys" $distroKeys "distrosData" $.packages.distros }} )
                {{ end }}
            {{ end }}
        {{ end }}
    {{ end }}
{{ end }}
# ==========================================
# Execute primary installation (bash level)
# ==========================================
if [[ "$CURRENT_OS" == "ubuntu" || "$CURRENT_OS" == "debian" ]]; then
    sudo apt-get update
fi

# If arch, filter missing packages safely
if [[ "$CURRENT_OS" == "arch" ]]; then
    VALID_SYSTEM_PKGS=()
    for pkg in "${SYSTEM_PKGS[@]}"; do
        if pacman -Ssq "^$pkg$" > /dev/null; then
            VALID_SYSTEM_PKGS+=("$pkg")
        else
            echo -e "${YELLOW}Warning: $pkg not found in arch repos, skipping.${NC}"
        fi
    done
    if [ ${#VALID_SYSTEM_PKGS[@]} -gt 0 ]; then
        echo -e "${BLUE}Running: $INSTALL_CMD${NC}"
        $INSTALL_CMD "${VALID_SYSTEM_PKGS[@]}"
    else
        echo -e "${YELLOW}No valid system packages to install.${NC}"
    fi
else
    if [ ${#SYSTEM_PKGS[@]} -gt 0 ]; then
        echo -e "${BLUE}Running: $INSTALL_CMD${NC}"
        $INSTALL_CMD "${SYSTEM_PKGS[@]}"
    else
        echo -e "${YELLOW}No system packages to install.${NC}"
    fi
fi

# ==========================================
# Handle AUR (arch only)
# ==========================================
if [[ "$CURRENT_OS" == "arch" && ${#AUR_PKGS[@]} -gt 0 ]]; then
    echo -e "${BLUE}Installing AUR packages...${NC}"
    if ! command -v yay &> /dev/null; then
        echo -e "${YELLOW}yay not found, installing yay-bin...${NC}"
        sudo pacman -S --needed --noconfirm base-devel git
        rm -rf /tmp/yay
        git clone https://aur.archlinux.org/yay-bin.git /tmp/yay
        (cd /tmp/yay && makepkg -si --noconfirm)
        rm -rf /tmp/yay
        hash -r
    fi
    yay -S --needed --noconfirm "${AUR_PKGS[@]}"
fi

echo -e "${GREEN}Package installation complete!${NC}"
